# ═══════════════════════════════════════════════════════════════
#  NOSSAS HISTÓRIAS — Variáveis de Ambiente
#  Copie este arquivo para .env e configure os valores
# ═══════════════════════════════════════════════════════════════

# Servidor
PORT=3000
NODE_ENV=development

# E-mail (para formulário de contato — use nodemailer futuramente)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=sua_senha_de_app
EMAIL_DESTINO=contato@nossashistorias.com.br

# YouTube (API Key opcional — para buscar vídeos recentes)
YOUTUBE_API_KEY=sua_chave_aqui
YOUTUBE_CHANNEL_ID=@nossashistorias

# Segurança
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_JANELA_MS=900000
RATE_LIMIT_MAX=100
